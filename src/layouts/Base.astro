---
import '@fontsource-variable/atkinson-hyperlegible-mono';
import '../styles/global.css';
import { site, nav, type NavKey } from '../data/site';
import { education, experience, skills } from '../data/experience';

interface Props {
  title: string;
  description?: string;
  current?: NavKey | '';
  noindex?: boolean;
  /** Extra schema.org objects for this page, e.g. a project's SoftwareSourceCode. */
  schema?: Record<string, unknown>[];
  /** Site-relative path to this page's share image, and its alt text. */
  image?: { src: string; alt: string };
  /** Open Graph type: 'profile' for the home page, 'article' for write-ups. */
  ogType?: 'website' | 'profile' | 'article';
}

const {
  title,
  description = site.description,
  current = '',
  noindex = false,
  schema = [],
  image = { src: '/og.png', alt: 'Ankan Poddar, senior full-stack engineer building AI products, shown as a terminal window.' },
  ogType = 'website',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image.src, site.url).href;
const [firstName, ...rest] = site.name.split(' ');
const fullTitle = title === site.name ? `${site.name}, senior full-stack engineer` : `${site.name} | ${title}`;

const person = {
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.name,
  url: site.url,
  description: site.description,
  image: new URL(site.photo, site.url).href,
  jobTitle: 'Senior full-stack engineer',
  worksFor: { '@type': 'Organization', name: experience[0].company },
  alumniOf: { '@type': 'CollegeOrUniversity', name: education.school },
  homeLocation: { '@type': 'Place', name: site.location },
  knowsAbout: skills.flatMap((s) => s.items),
  sameAs: [site.linkedin, site.github],
};

const graph = { '@context': 'https://schema.org', '@graph': [person, ...schema] };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0e1a3d" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    {ogType === 'profile' && <meta property="profile:first_name" content={firstName} />}
    {ogType === 'profile' && <meta property="profile:last_name" content={rest.join(' ')} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="bar">
      <div class="dots">
        <a class="dot d1" href="/" aria-label="Close: go to home" title="Close (home)"><svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true" focusable="false"><path d="M4.6 4.6l4.8 4.8M9.4 4.6L4.6 9.4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></a>
        <button class="dot d2" type="button" aria-label="Narrower layout" title="Minimize: narrower layout"><svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true" focusable="false"><path d="M3.8 7h6.4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button>
        <button class="dot d3" type="button" aria-label="Wider layout" title="Maximize: wider layout"><svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true" focusable="false"><path d="M7 3.8v6.4M3.8 7h6.4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button>
      </div>
      <div class="title"><a href="/" aria-label={`${site.name}, home`}>{site.name}</a></div>
    </header>

    <main id="main" class="term">
      <div class="col">
        <slot />
      </div>
    </main>

    <nav class="status" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>
                <span class="n" aria-hidden="true">{item.n}</span>{item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <em>{site.location}</em>
    </nav>
    <script>
      const root = document.documentElement;
      const less = document.querySelector<HTMLButtonElement>('.dot.d2');
      const more = document.querySelector<HTMLButtonElement>('.dot.d3');
      const sizes = ['is-narrow', '', 'is-wide'];
      let size = 1;
      const apply = () => {
        sizes.forEach((c) => c && root.classList.toggle(c, sizes[size] === c));
        less?.setAttribute('aria-disabled', String(size === 0));
        more?.setAttribute('aria-disabled', String(size === 2));
      };
      less?.addEventListener('click', () => { size = Math.max(0, size - 1); apply(); });
      more?.addEventListener('click', () => { size = Math.min(2, size + 1); apply(); });
    </script>
  </body>
</html>
