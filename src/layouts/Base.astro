---
import '@fontsource-variable/atkinson-hyperlegible-mono';
import '../styles/global.css';
import { site, nav, type NavKey } from '../data/site';

interface Props {
  title: string;
  description?: string;
  current?: NavKey | '';
  noindex?: boolean;
}

const { title, description = site.description, current = '', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og.png', site.url).href;
const fullTitle = title === site.name ? `${site.name}, senior full-stack engineer` : `${title} | ${site.name}`;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: 'Senior full-stack engineer',
  sameAs: [site.linkedin, site.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0e1a3d" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ankan Poddar, senior full-stack engineer building AI products, shown as a terminal window." />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="bar">
      <i class="d1"></i><i class="d2"></i><i class="d3"></i>
      <div class="title"><a href="/" aria-label={`${site.name}, home`}>{site.name}</a></div>
    </header>

    <main id="main" class="term">
      <div class="col">
        <slot />
      </div>
    </main>

    <nav class="status" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>
                <span class="n" aria-hidden="true">{item.n}</span>{item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <em>{site.location}</em>
    </nav>
  </body>
</html>
