---
const { slug } = Astro.props as { slug: string };
const bars = [3,1,2,1,4,1,1,3,2,1,3,1,2,2,1,4,1,2,1,3,1,1,2,3,1,2];
let x = 0;
const code = bars.map((w) => { const r = { x, w }; x += w * 2 + 2; return r; });
const codeW = x;
---

<svg class="art" viewBox="0 0 320 168" role="img" aria-hidden="true" focusable="false">
  {slug === 'studio' && (
    <g>
      <g stroke="#2a3b6b" stroke-width="1">
        {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => <path d={`M${24 + i * 34} 22v8`} />)}
        <path d="M24 30H296" />
      </g>
      <rect x="24" y="42" width="110" height="26" fill="#004d98" />
      <rect x="140" y="42" width="70" height="26" fill="#8db8f2" opacity=".85" />
      <rect x="216" y="42" width="80" height="26" fill="#004d98" />
      <rect x="24" y="74" width="60" height="26" fill="#a50044" />
      <rect x="90" y="74" width="120" height="26" fill="#a50044" opacity=".7" />
      <rect x="60" y="106" width="150" height="14" fill="#edbb00" opacity=".55" />
      <path d="M176 18v110" stroke="#edbb00" stroke-width="2" />
      <path d="M170 14h12l-6 9z" fill="#edbb00" />
      <rect x="24" y="140" width="272" height="6" fill="#0e1a3d" stroke="#2a3b6b" />
      <rect x="24" y="140" width="150" height="6" fill="#8db8f2" />
      <text x="24" y="162" fill="#c9d3ec" font-size="10">memory budget</text>
    </g>
  )}
  {slug === 'agentreplay' && (
    <g>
      <text x="24" y="28" fill="#c9d3ec" font-size="10">recorded run</text>
      <path d="M32 44H236" stroke="#2a3b6b" stroke-width="2" />
      {[32, 82, 132, 182].map((cx) => <circle cx={cx} cy="44" r="7" fill="#8db8f2" />)}
      <circle cx="236" cy="44" r="9" fill="#a50044" />
      <path d="M232 40l8 8m0-8l-8 8" stroke="#f4f6fb" stroke-width="2" />
      <path d="M132 44C150 44 150 112 176 112H282" fill="none" stroke="#edbb00" stroke-width="2" stroke-dasharray="4 4" />
      <path d="M32 112H132" stroke="#2a3b6b" stroke-width="2" />
      {[32, 82, 132].map((cx) => <circle cx={cx} cy="112" r="7" fill="#8db8f2" opacity=".5" />)}
      <circle cx="176" cy="112" r="7" fill="#edbb00" />
      <circle cx="226" cy="112" r="7" fill="#edbb00" />
      <circle cx="282" cy="112" r="9" fill="#004d98" stroke="#8db8f2" stroke-width="2" />
      <path d="M277 112l4 4 7-8" fill="none" stroke="#f4f6fb" stroke-width="2" />
      <text x="24" y="140" fill="#c9d3ec" font-size="10">forked run, diverges at step 3</text>
      <text x="196" y="68" fill="#edbb00" font-size="10">diverges</text>
    </g>
  )}
  {slug === 'clothtrends' && (
    <g>
      <g transform="translate(24 28)">
        {code.map((b) => <rect x={b.x} y="0" width={b.w * 2} height="64" fill="#f4f6fb" />)}
        <text x="0" y="82" fill="#c9d3ec" font-size="10">CODE_128</text>
        <path d={`M-6 32H${codeW + 6}`} stroke="#a50044" stroke-width="2" />
      </g>
      <g transform="translate(196 18)">
        <path d="M0 0h100v132l-10-6-10 6-10-6-10 6-10-6-10 6-10-6-10 6-10-6-10 6z" fill="#0e1a3d" stroke="#2a3b6b" />
        <path d="M12 22h52M12 38h76M12 54h60M12 70h68" stroke="#8db8f2" stroke-width="3" opacity=".8" />
        <path d="M12 92h76" stroke="#2a3b6b" />
        <rect x="12" y="102" width="40" height="8" fill="#edbb00" />
      </g>
    </g>
  )}
</svg>
