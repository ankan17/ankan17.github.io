---
import Base from '../layouts/Base.astro';
import Prompt from '../components/Prompt.astro';
import EndPrompt from '../components/EndPrompt.astro';
---

<Base title="Page not found" noindex description="This page does not exist.">
  <Prompt path="~" cmd="cd missing" />
  <h1 class="page-h">No such page</h1>
  <p class="lede">That address does not exist here. These do:</p>
  <ul class="log block">
    <li><a href="/">Home</a></li>
    <li><a href="/work/">Work</a></li>
    <li><a href="/experience/">Experience</a></li>
    <li><a href="/contact/">Contact</a></li>
  </ul>
  <EndPrompt path="~" />
</Base>
