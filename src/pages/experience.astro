---
import Base from '../layouts/Base.astro';
import Prompt from '../components/Prompt.astro';
import EndPrompt from '../components/EndPrompt.astro';
import { experience, education, achievements, skills, stats } from '../data/experience';

// Each employer is drawn as a git branch in its own colour.
const branch: Record<string, string> = { Avoca: 'var(--garnet)', HyperVerge: 'var(--blue)' };
const short = (p: string) => p.replace(' to present', ' → now').replace(' to ', ' → ');

---

<Base title="Experience" current="experience" description="Experience of Ankan Poddar: Deployed Engineer at Avoca, and five years at HyperVerge from SDE1 to Engineering Manager.">
  <h1 class="page-h">Experience</h1>
  <p class="lede">Five years from SDE1 to Engineering Manager at HyperVerge, now building AI agent integrations at Avoca.</p>

  <Prompt path="~" cmd="git shortlog --summary" class="log-cmd" />
  <ul class="stats">
    {stats.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span></li>)}
  </ul>

  <Prompt path="~" cmd="git log --decorate" class="log-cmd" />
  {
    experience.map((e, ei) => (
      <section class="employer" style={`--c:${branch[e.company] ?? 'var(--blue)'}`}>
        <h2 class="sr">{e.company}, {e.place}, {e.span}</h2>
        <ol class="rail">
          {e.roles.map((r, ri) => (
            <li>
              <details>
                <summary>
                  <span class="who">
                    <strong>{r.title}</strong>
                    {ri === 0 && <span class="ref branch" aria-hidden="true">{ei === 0 ? 'HEAD -> ' : ''}{e.company.toLowerCase()}</span>}
                    <span class="ref tag">{short(r.period)}</span>
                  </span>
                  <span class="lead">{r.lead}</span>
                </summary>
                <ul class="points">
                  {r.points.map((pt) => <li>{pt}</li>)}
                </ul>
              </details>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  <section class="block stackset">
    <Prompt path="~" cmd="cat stack" heading="Stack" />
    <dl class="chips">
      {skills.map((s) => (
        <div>
          <dt>{s.name}</dt>
          <dd>
            <ul>
              {s.items.map((i) => <li class:list={{ core: s.core?.includes(i) }}>{i}</li>)}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
    <p class="key"><span class="chip-key"></span> used daily</p>
  </section>

  <section class="block also">
    <Prompt path="~" cmd="cat education.txt recognition.txt" heading="Education and recognition" />
    <dl class="facts">
      <div><dt>education</dt><dd>{education.degree}, {education.school}, {education.period}. {education.note}.</dd></div>
      {achievements.map((a) => <div><dt>recognition</dt><dd>{a}</dd></div>)}
    </dl>
  </section>

  <EndPrompt path="~" />
</Base>
